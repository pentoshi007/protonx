<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/widgetIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_shield" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="-0.01"
            android:singleLine="true"
            android:text="@string/status_disconnected"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="@string/fastest_title"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widgetFastest"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/widget_fastest"
        android:padding="9dp"
        android:src="@drawable/ic_bolt" />

    <ImageButton
        android:id="@+id/widgetToggle"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/widget_connect"
        android:padding="10dp"
        android:src="@drawable/ic_power" />
</LinearLayout>
